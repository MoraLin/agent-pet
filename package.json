{
  "name": "agent-pet",
  "version": "1.4.0",
  "description": "Desktop pet that reacts to Claude Code and Codex CLI hook events - skin it with any compatible GIF pack (e.g. from codex-pets.net)",
  "author": "Mora Lin",
  "main": "main.js",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "build:prod": "node scripts/build-prod.js",
    "dist": "node scripts/build-prod.js && electron-builder --mac dmg --arm64 --publish never",
    "dist:x64": "node scripts/build-prod.js && electron-builder --mac dmg --x64 --publish never",
    "dist:win": "node scripts/build-prod.js && electron-builder --win portable --x64 --publish never",
    "lint": "node scripts/check-syntax.js",
    "test": "node scripts/check-syntax.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.agentpet.app",
    "productName": "Agent Pet",
    "files": [
      "main.js",
      "preload.js",
      "codex-hook-forward.js",
      "index.html",
      "style.css",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build",
      "app": "build-prod"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "artifactName": "Agent-Pet-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "portable",
      "artifactName": "Agent-Pet-win.${ext}"
    }
  }
}
