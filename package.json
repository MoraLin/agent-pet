{
  "name": "agent-pet",
  "version": "1.2.0",
  "description": "Desktop pet that reacts to Claude Code hook events - skin it with any GIF pack (e.g. from codex-pets.net)",
  "main": "main.js",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64",
    "dist:x64": "electron-builder --mac dmg --x64",
    "dist:win": "electron-builder --win portable --x64",
    "lint": "node scripts/check-syntax.js",
    "test": "node scripts/check-syntax.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.agentpet.app",
    "productName": "Agent Pet",
    "files": [
      "main.js",
      "preload.js",
      "skin-keywords.js",
      "codex-hook-forward.js",
      "index.html",
      "style.css",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "artifactName": "Agent-Pet-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "portable",
      "artifactName": "Agent-Pet-win.${ext}"
    }
  }
}
